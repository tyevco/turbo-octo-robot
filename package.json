{
  "name": "herdr-clicker-dev",
  "private": true,
  "type": "module",
  "description": "Development tooling for the herdr layout and mod in this repo. Not part of the share package.",
  "license": "MIT",
  "scripts": {
    "test": "node --import ./tools/node/register.mjs --test --test-concurrency=1 \"test/*.test.mjs\" \"test/!(qjs)/*.test.mjs\"",
    "test:qjs": "node --test --test-concurrency=1 \"test/qjs/*.test.mjs\"",
    "test:frozen": "node --import ./tools/node/frozen.mjs --import ./tools/node/register.mjs --test --test-concurrency=1 \"test/*.test.mjs\" \"test/!(qjs)/*.test.mjs\"",
    "shots": "node --import ./tools/node/register.mjs tools/shots/shoot.mjs",
    "sim": "node tools/sim/pacing.mjs",
    "check": "npm test && npm run test:qjs && npm run sim -- --assert"
  },
  "devDependencies": {
    "quickjs-emscripten-core": "0.32.0",
    "@jitl/quickjs-ng-wasmfile-release-sync": "0.32.0"
  }
}
